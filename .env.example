AUDITOR_STATE_DIR=./state
AUDITOR_SKILLS_DIR=./skills
AUDITOR_WORKFLOW=./design/workflow.json
AUDITOR_WEB_DIST=./apps/web/dist
AUDITOR_MODEL_GATEWAY=http://127.0.0.1:8081
AUDITOR_MODEL_ID=deepseek-flash
AUDITOR_MANTIS_OUTPUT_TOKENS=16384
AUDITOR_REPOSITORIES={}
AUDITOR_STANDARD_PACK=
AUDITOR_DOCLING_MODELS=
# Preloaded local multilingual embedding model; no runtime model download.
AUDITOR_EMBEDDING_MODEL_DIR=/models/embeddings/qwen3-embedding-0.6b
AUDITOR_RERANKER_MODEL_DIR=/models/rerankers/bge-reranker-v2-m3
# Temporary: no cumulative budgets or per-agent API call ceilings.
# Set true on both analysis and gateway to restore configurable limits.
AUDITOR_ENFORCE_BUDGETS=false
AUDITOR_MAX_REQUESTS=0
AUDITOR_MAX_TOKENS=0
AUDITOR_CONCURRENCY=2
AUDITOR_PROVIDER_CONCURRENCY=2
AUDITOR_PROVIDER_ATTEMPTS=3
# Set for the gateway when launching outside Compose (same DB as analysis).
AUDITOR_GATEWAY_DATABASE=./state/auditor.sqlite3
# Gateway process only. Never provide this variable to the analysis container.
DEEPSEEK_API_KEY=

# Initial language; the UI setting is persisted in the database.
AUDITOR_LANGUAGE=en

# Maximum output tokens per own analysis role (separate from total usage budget).
AUDITOR_AGENT_OUTPUT_TOKENS=16384
AUDITOR_AGENT_MAX_CALLS=0
