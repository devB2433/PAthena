  "issues": [
    {
      "version": "0.4.0",
      "requirements": [
        8,
        13
      ],
      "type": "安全价值/义务扩张",
      "detail": "把展示用途说明和性能监控选项单列为安全需求，缺少独立安全后果；安全目标之外的功能摘录增加了基线噪声。"
    },
    {
      "version": "0.5.0",
      "requirements": [
        7
      ],
      "type": "不必要的强制义务",
      "detail": "仍把显示标题的当前用途扩成对路径、URL、SQL 等用途的永久禁止，未证明真实危险解释流。"
    },
    {
      "version": "0.5.0",
      "requirements": [
        8
      ],
      "type": "来源分类",
      "detail": "准入控制是由共享可用性目标推导的新机制，整条却标为 EXPLICIT_DESIGN。"
    },
    {
      "version": "0.5.0",
      "requirements": [
        4
      ],
      "type": "过度限制内部动作",
      "detail": "原文禁止取消后发布，验收加入“不得写出或发布”，扩大到了未披露的私有临时写入。"
    },
    {
      "version": "0.5.1",
      "requirements": [
        11
      ],
      "type": "安全价值待删减",
      "detail": "性能监控择一仍被单列为安全需求；它与争议调查审计不同，缺少独立安全保护目的。"
    },
    {
      "version": "0.5.1",
      "requirements": [
        3
      ],
      "type": "正文与验收范围冲突",
      "detail": "正文允许委派管理员访问，首条验收却笼统拒绝“已认证用户”访问非本人任务，没有保留管理员例外。"
    },
    {
      "version": "0.5.1",
      "requirements": [
        1,
        2,
        3
      ],
      "type": "许可条件被写成成功保证",
      "detail": "部分正例要求全部对象授权即创建任务、管理员即生成结果、任务完成即返回；未保留准入、取消和到期等独立拒绝条件。"
    },
    {
      "version": "0.5.1",
      "requirements": [
        9
      ],
      "type": "完备度缺口",
      "detail": "日志控制覆盖发票敏感内容，但遗漏文档已描述的会话 bearer 凭证，已在冻结 Q09 中计 PARTIAL。"
    },
    {
      "version": "ALL",
      "requirements": [],
      "type": "后验额外观察，不计冻结分数",
      "detail": "取消是改变他人任务可用性的敏感操作；各版都约束取消/发布状态，却没有单独约束取消操作的主体授权。现有“流程对应一个需求”仍不足以证明每个安全不变量已覆盖。"
    }
  ],
