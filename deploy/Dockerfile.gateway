FROM python:3.12-slim-bookworm
WORKDIR /app
COPY requirements.gateway.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY src/security_auditor/__init__.py src/security_auditor/gateway.py src/security_auditor/provider.py ./security_auditor/
RUN useradd -u 10001 gateway
USER gateway
EXPOSE 8081
CMD ["uvicorn", "security_auditor.gateway:app", "--host", "0.0.0.0", "--port", "8081"]
